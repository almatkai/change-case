use change_case_beta_session_fixture::{Sessions,beta_common::{CoreContext,CorePaths}};
use serde_json::{json,Value};
use std::sync::{Arc,Mutex,atomic::{AtomicBool,Ordering}};
fn action(v:&Value,title:&str)->Value{v["actions"].as_array().unwrap().iter().find(|a|a["title"]==title).unwrap()["id"].clone()}
#[tokio::test]
async fn actual_beta_session_dispatch_binding_refresh_search_and_disposal(){
    let dir=tempfile::tempdir().unwrap();let ctx=CoreContext::new(CorePaths{data_dir:dir.path().join("data"),config_dir:dir.path().join("config"),resource_dir:dir.path().into(),temp_dir:dir.path().into(),home_dir:dir.path().into()},None);
    let calls=Arc::new(Mutex::new(Vec::new()));let record=calls.clone();ctx.set_router(Arc::new(move|channel,args|{record.lock().unwrap().push((channel.clone(),args));Box::pin(async move{match channel.as_str(){"clipboard:read"=>Ok(json!("from clipboard")),"core:platform:selected-text"=>Ok(json!("hello WORLD")),"core:platform:paste-text"=>Ok(json!({"ok":true})),_=>panic!("OS effect forbidden: {channel}")}})})).unwrap();
    let sessions=Sessions::default();let launch=json!({"extensionId":"com.tezbar.native.change-case","commandName":"change-case"});let v=sessions.call(&ctx,"extension:run-command",launch.clone()).await;assert_eq!(v["mode"],"view");if let Ok(path)=std::env::var("CHANGE_CASE_EXPORT_VIEW"){std::fs::write(path,serde_json::to_vec_pretty(&v).unwrap()).unwrap();}let id=v["sessionId"].clone();let old=action(&v,"Copy to Clipboard");let other=sessions.call(&ctx,"extension:run-command",launch).await;
    let forged=sessions.call(&ctx,"extension:invoke-action",json!({"sessionId":other["sessionId"],"actionId":old})).await;assert_eq!(forged["ok"],false);
    let refresh=sessions.call(&ctx,"extension:refresh-session",json!({"sessionId":id})).await;assert_eq!(refresh["mode"],"unchanged");
    let searched=sessions.call(&ctx,"extension:search-text-changed",json!({"sessionId":id,"searchText":"macro"})).await;assert_eq!(searched["root"]["children"][2]["children"].as_array().unwrap().len(),1);
    assert_eq!(sessions.call(&ctx,"extension:invoke-action",json!({"sessionId":id,"actionId":old})).await["ok"],false);
    let result=sessions.call(&ctx,"extension:invoke-action",json!({"sessionId":id,"actionId":action(&searched,"Paste in Active App"),"value":"INJECT"})).await;assert_eq!(result["mode"],"no-view");let writes:Vec<_>=calls.lock().unwrap().iter().filter(|(s,_)|s=="core:platform:paste-text").cloned().collect();assert_eq!(writes,vec![("core:platform:paste-text".into(),vec![json!("HELLO_WORLD")])]);
    assert_eq!(sessions.call(&ctx,"extension:dispose-session",json!({"sessionId":id})).await,true);assert_eq!(sessions.call(&ctx,"extension:invoke-action",json!({"sessionId":id,"actionId":old})).await["ok"],false);sessions.clear().await;
}
#[tokio::test]
async fn dropped_paste_waits_for_deliberate_retry_and_clear_cancels(){
    let dir=tempfile::tempdir().unwrap();let ctx=CoreContext::new(CorePaths{data_dir:dir.path().join("data"),config_dir:dir.path().into(),resource_dir:dir.path().into(),temp_dir:dir.path().into(),home_dir:dir.path().into()},None);let entered=Arc::new(tokio::sync::Notify::new());let hang=Arc::new(AtomicBool::new(true));let writes=Arc::new(Mutex::new(0));let (e,h,w)=(entered.clone(),hang.clone(),writes.clone());ctx.set_router(Arc::new(move|channel,_|{let (e,h,w)=(e.clone(),h.clone(),w.clone());Box::pin(async move{match channel.as_str(){"clipboard:read"|"core:platform:selected-text"=>Ok(json!("abc")),"core:platform:paste-text"=>{*w.lock().unwrap()+=1;e.notify_one();if h.load(Ordering::Relaxed){std::future::pending::<()>().await;}Ok(json!({"ok":true}))},_=>panic!("OS forbidden")}})})).unwrap();
    let sessions=Sessions::default();let v=sessions.call(&ctx,"extension:run-command",json!({"extensionId":"com.tezbar.native.change-case","commandName":"change-case"})).await;let id=v["sessionId"].clone();let paste=action(&v,"Paste in Active App");let (s,c,body)=(sessions.clone(),ctx.clone(),json!({"sessionId":id,"actionId":paste}));let task=tokio::spawn(async move{s.call(&c,"extension:invoke-action",body).await});entered.notified().await;task.abort();let _=task.await;hang.store(false,Ordering::Relaxed);
    let recovery=sessions.call(&ctx,"extension:invoke-action",json!({"sessionId":id,"actionId":paste})).await;assert_eq!(*writes.lock().unwrap(),1);assert_eq!(recovery["root"]["type"],"Detail");let retry=action(&recovery,"Retry Action (May Repeat Previous Paste)");let done=sessions.call(&ctx,"extension:invoke-action",json!({"sessionId":id,"actionId":retry})).await;assert_eq!(done["mode"],"no-view");assert_eq!(*writes.lock().unwrap(),2);sessions.clear().await;
}
